{
  "name": "bettingify",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "mobile:sync": "npm run build -- --mode mobile && cap sync android",
    "mobile:android": "npm run mobile:sync && cd android && gradlew.bat assembleDebug --no-daemon --max-workers=1",
    "mobile:android:release": "npm run mobile:sync && cap build android --androidreleasetype APK",
    "mobile:ios": "npm run build -- --mode mobile && cap sync ios && cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "desktop:backend-build": "npm --prefix ../backend run build",
    "desktop:dev": "npm run build && npm run desktop:backend-build && electron .",
    "desktop:package": "npm run build && npm run desktop:backend-build && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@supabase/supabase-js": "^2.57.4",
    "firebase": "^13.2.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.18",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.bettingify.desktop",
    "productName": "Bettingify",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "../backend/package.json",
        "to": "backend/package.json"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.28.2": true
  }
}
